<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Nine Vicious — Anal</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            width: 100%;
            height: 100vh;
            overflow: hidden;

            font-family: Arial, sans-serif;

            color: white;
            background: #050505;
        }

        /* ФОН */

        .background {
            position: fixed;
            top: -50px;
            left: -50px;
            right: -50px;
            bottom: -50px;

            background-image: url("cover.jpg");
            background-size: cover;
            background-position: center;

            filter: blur(35px);

            transform: scale(1.15);

            z-index: 0;
        }

        /* Затемнение */

        .background::after {
            content: "";

            position: absolute;
            inset: 0;

            background: rgba(0, 0, 0, 0.65);
        }


        /* ОСНОВНОЙ КОНТЕНТ */

        .main {
            position: relative;

            z-index: 2;

            width: 100%;
            height: 100vh;

            display: flex;
            justify-content: center;
            align-items: center;

            padding: 40px;
        }


        .content {
            width: 1200px;
            max-width: 100%;

            display: flex;

            align-items: center;

            justify-content: space-between;

            gap: 80px;
        }


        /* ОБЛОЖКА */

        .cover-wrapper {
            flex: 1;

            display: flex;

            justify-content: center;
        }


        .cover {
            width: min(520px, 40vw);
            aspect-ratio: 1 / 1;

            border-radius: 25px;

            overflow: hidden;

            border: 1px solid rgba(255,255,255,0.2);

            box-shadow:
                0 30px 100px rgba(0,0,0,0.8),
                0 0 80px rgba(255,255,255,0.08);

            animation: float 5s ease-in-out infinite;
        }


        .cover img {
            width: 100%;
            height: 100%;

            object-fit: cover;

            display: block;
        }


        /* ПРАВАЯ ЧАСТЬ */

        .info {
            flex: 1;
        }


        .label {
            font-size: 13px;

            letter-spacing: 6px;

            color: rgba(255,255,255,0.45);

            text-transform: uppercase;

            margin-bottom: 20px;
        }


        .title {
            font-size: clamp(60px, 8vw, 115px);

            font-weight: 900;

            line-height: 0.85;

            letter-spacing: -6px;

            margin-bottom: 25px;
        }


        .artist {
            font-size: 27px;

            color: rgba(255,255,255,0.7);

            letter-spacing: 2px;

            margin-bottom: 45px;
        }


        /* ПЛЕЕР */

        .player {
            width: 100%;

            padding: 25px;

            border-radius: 20px;

            background: rgba(255,255,255,0.09);

            border: 1px solid rgba(255,255,255,0.15);

            backdrop-filter: blur(25px);

            box-shadow:
                0 20px 60px rgba(0,0,0,0.4);
        }


        .now-playing {
            font-size: 11px;

            letter-spacing: 3px;

            color: rgba(255,255,255,0.4);

            margin-bottom: 15px;

            text-transform: uppercase;
        }


        audio {
            width: 100%;

            height: 45px;
        }


        /* НИЖНИЙ ТЕКСТ */

        .footer {
            position: fixed;

            bottom: 25px;
            left: 30px;

            z-index: 5;

            font-size: 11px;

            letter-spacing: 3px;

            color: rgba(255,255,255,0.3);

            text-transform: uppercase;
        }


        /* АНИМАЦИЯ ОБЛОЖКИ */

        @keyframes float {

            0% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-12px);
            }

            100% {
                transform: translateY(0);
            }

        }


        /* ТЕЛЕФОН */

        @media (max-width: 800px) {

            body {
                overflow: auto;
            }

            .main {
                height: auto;

                min-height: 100vh;

                padding: 30px 20px;
            }

            .content {
                flex-direction: column;

                gap: 40px;
            }

            .cover {
                width: min(450px, 85vw);
            }

            .info {
                width: 100%;

                text-align: center;
            }

            .title {
                font-size: 70px;

                letter-spacing: -4px;
            }

            .artist {
                margin-bottom: 30px;
            }

            .footer {
                display: none;
            }
        }

    </style>

</head>


<body>


    <!-- ФОНОВАЯ ОБЛОЖКА -->

    <div class="background"></div>


    <!-- ОСНОВНОЙ КОНТЕНТ -->

    <main class="main">

        <div class="content">


            <!-- ОБЛОЖКА -->

            <div class="cover-wrapper">

                <div class="cover">

                    <img
                        src="cover.jpg"
                        alt="Nine Vicious — Anal"
                    >

                </div>

            </div>


            <!-- ИНФОРМАЦИЯ -->

            <div class="info">

                <div class="label">
                    Single
                </div>


                <div class="title">
                    ANAL
                </div>


                <div class="artist">
                    Nine Vicious
                </div>


                <!-- МУЗЫКА -->

                <div class="player">

                    <div class="now-playing">
                        Now Playing
                    </div>

                    <audio controls>

                        <source
                            src="Anal.mp3"
                            type="audio/mpeg"
                        >

                        Ваш браузер не поддерживает аудио.

                    </audio>

                </div>

            </div>

        </div>

    </main>


    <!-- НИЖНЯЯ НАДПИСЬ -->

    <div class="footer">
        Nine Vicious • Anal
    </div>


</body>

</html>
